includes:
    - .Build/vendor/saschaegerer/phpstan-typo3/extension.neon
    - .Build/vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
    level: 8
    paths:
        - Classes
        - Configuration
        - Tests
    # Optional dependencies referenced behind class_exists() guards; see the file.
    scanFiles:
        - Build/phpstan/OptionalDependencies.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
