    <body>
      <trans-unit id="mlang_labels_tablabel">
        <source>Abilities registry</source>
      </trans-unit>
      <trans-unit id="mlang_labels_tabdescr">
        <source>Browse and run the installation's abilities — the typed, permissioned capability registry — as your backend user, through the governed execution pipeline.</source>
      </trans-unit>
      <trans-unit id="mlang_tabs_tab">
        <source>Abilities</source>
      </trans-unit>
      <trans-unit id="headline">
        <source>Abilities registry</source>
      </trans-unit>

      <trans-unit id="tab.registry">
        <source>Registry</source>
      </trans-unit>
      <trans-unit id="tab.run">
        <source>Run</source>
      </trans-unit>
      <trans-unit id="tab.traces">
        <source>Traces</source>
      </trans-unit>
      <trans-unit id="tab.tokens">
        <source>Tokens</source>
      </trans-unit>
      <trans-unit id="tab.catalog">
        <source>Catalogue</source>
      </trans-unit>
      <trans-unit id="catalog.intro">
        <source>Everything this installation can do, from every source: the abilities of this registry, the native tools of the MCP server, agent skills, REST and webhook endpoints and console commands. Each entry tells an agent how to invoke it from each surface. The same catalogue is served by abilities:catalog, GET /abilities/v1/catalog and the MCP tool ability_abilities_catalog.</source>
      </trans-unit>
      <trans-unit id="catalog.caption">
        <source>Capabilities of the installation with source, surfaces, annotations and invocations</source>
      </trans-unit>
      <trans-unit id="catalog.filters">
        <source>Filter the catalogue</source>
      </trans-unit>
      <trans-unit id="catalog.schema.help">
        <source>An input schema is known for this entry</source>
      </trans-unit>
      <trans-unit id="filter.source">
        <source>Source</source>
      </trans-unit>
      <trans-unit id="column.id">
        <source>Capability</source>
      </trans-unit>
      <trans-unit id="column.source">
        <source>Source · surfaces</source>
      </trans-unit>
      <trans-unit id="column.invocations">
        <source>How to invoke</source>
      </trans-unit>

      <trans-unit id="registry.intro">
        <source>This is the backend projection of the abilities registry — no separate login or token. Runs execute as your backend user through the same governed pipeline that serves CLI, MCP and REST: policy → input validation → scopes → permission → execute → output validation. Every attempt is recorded in the Traces tab.</source>
      </trans-unit>
      <trans-unit id="registry.empty">
        <source>No abilities are registered in this installation.</source>
      </trans-unit>
      <trans-unit id="registry.caption">
        <source>Registered abilities with their category, annotations, required scopes, side effects and projection surfaces</source>
      </trans-unit>
      <trans-unit id="registry.filters">
        <source>Filter the registry</source>
      </trans-unit>

      <trans-unit id="filter.search">
        <source>Search</source>
      </trans-unit>
      <trans-unit id="filter.search.placeholder">
        <source>Name, title or description</source>
      </trans-unit>
      <trans-unit id="filter.category">
        <source>Category</source>
      </trans-unit>
      <trans-unit id="filter.surface">
        <source>Surface</source>
      </trans-unit>
      <trans-unit id="filter.risk">
        <source>Risk tier</source>
      </trans-unit>
      <trans-unit id="filter.outcome">
        <source>Outcome</source>
      </trans-unit>
      <trans-unit id="filter.outcome.ok">
        <source>Successful</source>
      </trans-unit>
      <trans-unit id="filter.outcome.failed">
        <source>Failed or denied</source>
      </trans-unit>
      <trans-unit id="filter.all">
        <source>All</source>
      </trans-unit>

      <trans-unit id="column.ability">
        <source>Ability</source>
      </trans-unit>
      <trans-unit id="column.category">
        <source>Category</source>
      </trans-unit>
      <trans-unit id="column.annotations">
        <source>Annotations</source>
      </trans-unit>
      <trans-unit id="column.scopes">
        <source>Scopes</source>
      </trans-unit>
      <trans-unit id="column.sideEffects">
        <source>Side effects</source>
      </trans-unit>
      <trans-unit id="column.surfaces">
        <source>Surfaces</source>
      </trans-unit>
      <trans-unit id="column.actions">
        <source>Actions</source>
      </trans-unit>
      <trans-unit id="column.traceUid">
        <source>Trace</source>
      </trans-unit>
      <trans-unit id="column.tokenUid">
        <source>Token</source>
      </trans-unit>
      <trans-unit id="column.when">
        <source>When</source>
      </trans-unit>
      <trans-unit id="column.surface">
        <source>Surface</source>
      </trans-unit>
      <trans-unit id="column.outcome">
        <source>Outcome</source>
      </trans-unit>
      <trans-unit id="column.duration">
        <source>Duration</source>
      </trans-unit>
      <trans-unit id="column.beUser">
        <source>Backend user</source>
      </trans-unit>
      <trans-unit id="column.input">
        <source>Input</source>
      </trans-unit>

      <trans-unit id="annotation.readOnly.help">
        <source>Read-only: declares no side effects and is served with GET over REST.</source>
      </trans-unit>
      <trans-unit id="annotation.destructive.help">
        <source>Destructive: deletes or irreversibly alters data, and is served with DELETE over REST.</source>
      </trans-unit>
      <trans-unit id="annotation.idempotent.help">
        <source>Idempotent: running it again with the same input is safe.</source>
      </trans-unit>
      <trans-unit id="sideEffects.none">
        <source>none</source>
      </trans-unit>
      <trans-unit id="action.run">
        <source>Run</source>
      </trans-unit>

      <trans-unit id="run.select">
        <source>Ability</source>
      </trans-unit>
      <trans-unit id="run.select.empty">
        <source>Choose an ability…</source>
      </trans-unit>
      <trans-unit id="run.input">
        <source>Input</source>
      </trans-unit>
      <trans-unit id="run.approve">
        <source>Approve review — this run is otherwise blocked by the site policy</source>
      </trans-unit>
      <trans-unit id="run.execute">
        <source>Execute</source>
      </trans-unit>
      <trans-unit id="run.reset">
        <source>Reset</source>
      </trans-unit>
      <trans-unit id="run.result">
        <source>Result</source>
      </trans-unit>
      <trans-unit id="run.result.empty">
        <source>Not run yet. Runs execute on the "backend" surface as your user.</source>
      </trans-unit>

      <trans-unit id="traces.intro">
        <source>The newest execution traces of this installation — every attempt from every surface, successful or denied. Traces are pruned after the retention configured in the extension settings.</source>
      </trans-unit>
      <trans-unit id="traces.filters">
        <source>Filter the traces</source>
      </trans-unit>
      <trans-unit id="traces.caption">
        <source>Execution traces, newest first</source>
      </trans-unit>
      <trans-unit id="traces.reload">
        <source>Reload</source>
      </trans-unit>

      <trans-unit id="tokens.intro">
        <source>Bearer tokens for the REST projection, bound to your backend user. A token never widens your own permissions: its scopes are intersected with the scopes your backend groups grant. Only the SHA-256 hash is stored, so the token itself is shown exactly once.</source>
      </trans-unit>
      <trans-unit id="tokens.caption">
        <source>Active REST bearer tokens</source>
      </trans-unit>
      <trans-unit id="tokens.name">
        <source>Name</source>
      </trans-unit>
      <trans-unit id="tokens.name.placeholder">
        <source>e.g. n8n production</source>
      </trans-unit>
      <trans-unit id="tokens.scopes">
        <source>Scopes</source>
      </trans-unit>
      <trans-unit id="tokens.scopes.help">
        <source>Select none to issue a discovery-only token.</source>
      </trans-unit>
      <trans-unit id="tokens.expires">
        <source>Expires in (days)</source>
      </trans-unit>
      <trans-unit id="tokens.expires.never">
        <source>never</source>
      </trans-unit>
      <trans-unit id="tokens.lastUsed">
        <source>Last used</source>
      </trans-unit>
      <trans-unit id="tokens.create">
        <source>Create token</source>
      </trans-unit>
      <trans-unit id="tokens.plaintext.warning">
        <source>Copy this token now — it is shown only once and cannot be retrieved again.</source>
      </trans-unit>
    </body>
